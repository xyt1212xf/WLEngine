--================================================================================
-- DefaultLevel.me  —  关卡数据（对标 UE 的 ULevel 序列化内容）
--
-- 这个文件只描述"场景里有什么、在哪、用什么材质"，
-- 逻辑写在 Run/Script/actor/*.lua，通过 Script 字段挂到 Actor 上
-- （对标 UE 里 AActor 通过 UClass* 指向一个 Blueprint 类）。
--
-- 加载方式：CLevel::Load（对标 ULevel::Serialize）在一个独立的、只开了
-- base/table/math/string 的 lua_State 里 dofile 本文件，取返回的 table，
-- 读完即 lua_close。它不接触 CScriptPlug 的游戏逻辑 VM。
-- CWorld::LoadPersistentLevel 只负责持有这个 level 并登记 StreamingLevels。
--
-- 约定：
--   * Rotation 一律写 Euler 度（编辑器习惯，对标 UE 的 FRotator），
--     内部转成四元数存储（对标 FTransform::Rotation）。
--   * 材质属于 mesh 资产；组件上的 OverrideMaterials 才是覆盖（对标 UE 的
--     UMeshComponent::OverrideMaterials）。留空则用 mesh 自己的材质槽。
--   * OverrideMaterials 里的名字先在关卡自己声明的 Materials 表里找，
--     找不到再去全局材质注册表（CGraphicPlug 建的 "Default"）。
--     材质目前不是独立资产文件，所以谁声明谁拥有（关卡卸载时释放）。
--   * Mesh 用 Source 区分"怎么来"，Shape / Path 区分"是什么"：
--       - Source = "Procedural" : 程序化生成，用 Shape 选形状
--           Shape = "Cube"   : 立方体（Center + HalfExtents）
--           Shape = "Sphere" : 球体（Center + Radius + 可选 Slices/Stacks）
--       - Source = "Asset" : 外部网格资产，用 Path 指向文件（等 FBX 导入器
--         接进来后，Path 填 .fbx 即可；LoadMesh 里该分支已留好 TODO）。
--================================================================================

return {
    Name = "DefaultLevel",

    -- 内联材质（对标 UE 里 level package 对材质资产的引用列表）。
    -- VS / PS 是全局 shader 名（对标材质的 FShaderMap / shader permutation）；
    -- Texture 是 base color 贴图路径，由 CTextureMgr 按路径缓存并持有。
    Materials = {
        {
            Name    = "BlackMat",
            VS      = "CTexturedVS",
            PS      = "CTexturedPS",
            Texture = "Resource/Texture/grass_top.png",
        },
		{
            Name    = "AlphaBlackMat",
            VS      = "CTexturedVS",
            PS      = "CTexturedPS",
            Texture = "Resource/Texture/Voxel/line.png",
            Blend   = "Translucent",   -- 透明材质：渲染器放到透明趟，按距离从远到近画
        },
		{
            Name    = "LightMat",
            VS      = "CLightVS",
            PS      = "CLightPS",
            Texture = "Resource/Texture/DirectionLight.png",
        },
    },

    Actors = {
        {
            Name   = "Cube_01",
            Label  = "测试立方体",
            Script = "actor/CubeActor",     -- 逻辑类（对标 AActor 的 UClass*）
            Tags   = { "Prop", "Static" },  -- 对标 AActor::Tags
            Tick   = false,                 -- 对标 AActor::bCanEverTick / SetActorTickEnabled

            -- 对标 AActor::SetActorTransform
            -- 注意：bring-up 阶段的相机硬编码在原点、朝 +Z 看（Renderer::_Flush），
            -- 所以 Location.z 必须为正在相机前方，写负数会跑到镜头背后。
            Transform = {
                Location = { 0, 0, 5 },
                Rotation = { 0, 0, 0 },     -- Euler 度
                Scale    = { 1, 1, 1 },
            },

            Components = {
                {
                    Type    = "StaticMesh",
                    Visible = true,         -- 对标 USceneComponent::bVisible

                    Mesh = {
                        Source      = "Procedural",
                        Shape       = "Cube",
                        Center      = { 0, 0, 0 },
                        HalfExtents = { 1, 1, 1 },
                    },

                    -- 对标 UMeshComponent::OverrideMaterials，按材质槽下标覆盖。
                    -- "BlackMat" 在上面 Materials 表里声明：Textured 着色器 + black.png。
                    OverrideMaterials = { "BlackMat" },

                    -- 对标 USceneComponent::RelativeLocation/Rotation/Scale3D
                    -- RelativeTransform = { Location = {0,0,0}, Rotation = {0,0,0}, Scale = {1,1,1} },
                },
            },
        },

        {
            Name   = "Cube_02",
            Label  = "测试立方体2",
            Script = "actor/CubeActor",
            Tick   = false,

            -- 第二个 cube：相机朝 +Z，z 必须为正；x 偏移 3 与 Cube_01 并排，
            -- Y 轴转 45° 让两个 cube 在画面上可区分（旋转走 Actor Transform → 世界矩阵 → MVP）。
            Transform = {
                Location = { 3, 0, 5 },
                Rotation = { 0, 45, 0 },   -- Euler 度
                Scale    = { 1, 1, 1 },
            },

            Components = {
                {
                    Type    = "StaticMesh",
                    Visible = true,

                    Mesh = {
                        Source      = "Procedural",
                        Shape       = "Cube",
                        Center      = { 0, 0, 0 },
                        HalfExtents = { 1, 1, 1 },
                    },

                    OverrideMaterials = { "AlphaBlackMat" },
                },
            },
        },

        -- Sphere Actor：程序化球体，Shape = "Sphere"
        {
            Name   = "Sphere_01",
            Label  = "测试球体",
            Script = "actor/SphereActor",
            Tick   = false,

            Transform = {
                Location = { -3, 0, 5 },   -- 在 Cube_01 左侧并排，z 必须为正（相机朝 +Z）
                Rotation = { 0, 0, 0 },
                Scale    = { 1, 1, 1 },
            },

            Components = {
                {
                    Type    = "StaticMesh",
                    Visible = true,

                    -- Procedural 球体：Shape 指定形状，Radius / Slices / Stacks 可选
                    Mesh = {
                        Source = "Procedural",
                        Shape  = "Sphere",
                        Center = { 0, 0, 0 },
                        Radius = 1.0,    -- 半径，默认 1.0
                        Slices = 32,     -- 经线分段（可选，默认 24）
                        Stacks = 24,     -- 纬线分段（可选，默认 16）
                    },

                    OverrideMaterials = { "LightMat" },
                },
            },
        },

        -- 资产形态示例（等 FBX 导入器接进来后启用）：Path 指向 .fbx
        -- {
        --     Name = "Chair_01",
        --     Transform = { Location = { 5, 0, 2 } },
        --     Components = {
        --         {
        --             Type    = "StaticMesh",
        --             Visible = true,
        --             Mesh = { Source = "Asset", Path = "Resource/Mesh/Chair.fbx" },
        --         },
        --     },
        -- },
    },

    -- 对标 UWorld::StreamingLevels (ULevelStreaming)：这里只登记，不加载
    StreamingLevels = {
        -- { Name = "SubLevel", Path = "Resource/Level/SubLevel.me" },
    },
}
