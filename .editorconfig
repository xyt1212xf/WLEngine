root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,c,cc,cxx,hxx,inl}]
charset = utf-8-bom
indent_style = tab
indent_size = 4
tab_width = 4

[*.{cs,vb}]
charset = utf-8-bom
indent_style = smart
indent_size = 4

[*.{xml,json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{hlsl,hlsli,usf}]
charset = utf-8-bom
indent_style = tab
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false